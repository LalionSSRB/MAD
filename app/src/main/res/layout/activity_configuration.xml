<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:padding="24dp"
    tools:context=".ConfigurationActivity">

    <TextView
        android:id="@+id/tvConfigTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings / Configuration"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/tvPlayerNamePrompt"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tvPlayerNamePrompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Player Display Name:"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@+id/tvConfigTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/etPlayerName" />

    <EditText
        android:id="@+id/etPlayerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="8dp"
        android:hint="Enter your name"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@+id/tvPlayerNamePrompt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/tvTargetScorePrompt" />

    <TextView
        android:id="@+id/tvTargetScorePrompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Target Points to Win (RPS Game):"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@+id/etPlayerName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/etTargetScore" />

    <EditText
        android:id="@+id/etTargetScore"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="8dp"
        android:hint="e.g., 3"
        android:inputType="number"
        app:layout_constraintTop_toBottomOf="@+id/tvTargetScorePrompt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btnSaveConfig" />

    <Button
        android:id="@+id/btnSaveConfig"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="24dp"
        android:text="Save Settings"
        app:layout_constraintTop_toBottomOf="@+id/etTargetScore"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btnReturnConfig" />

    <Button
        android:id="@+id/btnReturnConfig"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="12dp"
        android:text="Back to Main Menu"
        app:layout_constraintTop_toBottomOf="@+id/btnSaveConfig"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>