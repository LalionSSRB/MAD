<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".BingoGameActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- 1. Game Title -->
        <TextView
            android:id="@+id/tvBingoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5x5 Bingo"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/tvSeriesScore"
            app:layout_constraintVertical_chainStyle="packed" />

        <!-- 2. Best-of-3 Series Scoreboard -->
        <TextView
            android:id="@+id/tvSeriesScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Best of 3: Player 0 - 0 CPU"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@+id/tvBingoTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/tvBingoInfo" />

        <!-- 3. Player & Round Counter -->
        <TextView
            android:id="@+id/tvBingoInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Player: Admin | Round: 0"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@+id/tvSeriesScore"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/tvDrawnNumber" />

        <!-- 4. Drawn Number & Countdown Status -->
        <TextView
            android:id="@+id/tvDrawnNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tap 'Draw Next Number' to start!"
            android:textAlignment="center"
            android:textSize="16sp"
            android:textStyle="italic"
            app:layout_constraintTop_toBottomOf="@+id/tvBingoInfo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/layoutBoardsContainer" />

        <!-- 5. Side-by-Side 5x5 Boards (Player vs CPU Opponent) -->
        <LinearLayout
            android:id="@+id/layoutBoardsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/tvDrawnNumber"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/btnDrawNumber">

            <!-- Left Column: Player 5x5 Board -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tvPlayerBoardLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Your Board"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <GridLayout
                    android:id="@+id/gridPlayerBoard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="5"
                    android:rowCount="5" />
            </LinearLayout>

            <!-- Right Column: Opponent 5x5 Board -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tvCpuBoardLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Opponent Board"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <GridLayout
                    android:id="@+id/gridCpuBoard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="5"
                    android:rowCount="5" />
            </LinearLayout>

        </LinearLayout>

        <!-- 6. Draw Next Number Button -->
        <Button
            android:id="@+id/btnDrawNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="20dp"
            android:text="Draw Next Number"
            app:layout_constraintTop_toBottomOf="@+id/layoutBoardsContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/btnNewBingo" />

        <!-- 7. Reset Best-of-3 Series Button -->
        <Button
            android:id="@+id/btnNewBingo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="10dp"
            android:text="Reset Series (Best of 3)"
            app:layout_constraintTop_toBottomOf="@+id/btnDrawNumber"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/btnViewHistory" />

        <!-- 8. View SQLite Match History Button -->
        <Button
            android:id="@+id/btnViewHistory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="10dp"
            android:text="View SQLite Match History"
            app:layout_constraintTop_toBottomOf="@+id/btnNewBingo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/btnBackFromBingo" />

        <!-- 9. Back to Main Menu Button -->
        <Button
            android:id="@+id/btnBackFromBingo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="10dp"
            android:text="Back to Main Menu"
            app:layout_constraintTop_toBottomOf="@+id/btnViewHistory"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>